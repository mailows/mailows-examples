# Copy to .env (gitignored) or export in your shell.
# MCP accepts OAuth access tokens only. A portal / REST API key will not work.

# Short-lived OAuth access token for the resource https://mcp.mailows.com
MCP_ACCESS_TOKEN=

# Optional. Leave empty when the OAuth grant covers a single mailbox;
# mail_send_message then picks that mailbox itself.
MAIL_INBOX_ID=

# Must already be on the mailbox send allowlist.
MAIL_TO=finance@example.com

# File to attach (PDF, Office, images and text are typical).
MAIL_ATTACHMENT=./python/fixtures/hello.txt
